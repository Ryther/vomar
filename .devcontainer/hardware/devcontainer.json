{
  "name": "Vomar Linux hardware (opt in)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--device=/dev/bus/usb",
    "--group-add=plugdev"
  ],
  "mounts": [
    "source=/run/dbus/system_bus_socket,target=/run/dbus/system_bus_socket,type=bind,readonly",
    "source=vomar-github-state,target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "python tools/dev/container_check.py && python tools/dev/bootstrap.py workspace",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker@sha256:698f5900fac471e046c6e9d4333fec88c0e8d952c713494fa0712dce80baeca0": {
      "version": "29.9.2-ubuntu24.04u2",
      "moby": true,
      "mobyBuildxVersion": "0.38.1-ubuntu24.04u2",
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": true,
      "installDockerComposeSwitch": false,
      "socketPath": "/var/run/docker-host.sock"
    },
    "ghcr.io/devcontainers/features/github-cli@sha256:bd7ab48a832228f633239277552c30b353867fef2e5b037e064b4e64f0b843f2": {
      "version": "2.103.2",
      "installDirectlyFromGitHubRelease": true
    }
  },
  "postStartCommand": "python tools/dev/container_check.py"
}
