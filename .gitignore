# Private research and local evidence. Keep these on disk, outside public Git.
/inputs/*
!/inputs/README.md
/analysis/
/experiments/
/work/
/third_party/openvsh/
/_test*/
/_tmp*/

# Local coding-agent setup, sessions, installed skills and working briefs.
/.devcontainer/
/.agents/
/.claude/
/.codex/
/.impeccable/
/.superpowers/
/.worktrees/
/prompts/
/tools/helpers/first-codex-task.sh
/tools/tests/test-devcontainer-*.sh
/PRODUCT.md
/DESIGN.md
/docs/superpowers/
/apps/android-updater/preview/

# Credentials and local signing material. Public verification keys are source.
.env
.env.*
!.env.example
*.keystore
*.jks
*-private.pem
*-private.der
*-cookie.txt
*-auth.json
/firmware/keys/*
!/firmware/keys/dev-public.pem
!/firmware/keys/README.md

# SDKs, dependencies and local editor/build state.
node_modules/
.gradle/
.kotlin/
.idea/
local.properties
.venv/
venv/
env/
.cache/
.mcp-cache/
.npm/
