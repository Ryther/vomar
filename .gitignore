# Reviewed, synthetic public test fixtures and the pinned Gradle bootstrap.
!apps/android-updater/gradle/wrapper/gradle-wrapper.jar
!apps/android-updater/test-fixtures/synthetic-*.zip
!apps/android-updater/app/src/androidTest/assets/synthetic-*.zip
