# Python caches, coverage and disposable test output.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage/
htmlcov/
coverage.xml
*.lcov

# Native/Android outputs belong in release assets, not the source tree.
build/
builds/
dist/
out/
target/
