{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryther/vomar/blob/main/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "distributionVersion",
    "tag",
    "commit",
    "components",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "distributionVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "filename",
          "size",
          "sha256",
          "componentVersion"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "componentVersion": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "linux",
              "windows",
              "macos"
            ]
          },
          "architecture": {
            "enum": [
              "x64",
              "arm64"
            ]
          }
        }
      }
    }
  }
}
