# Keep this opt-in profile independent of the existing Partition Manager builds.
if(SB_CONFIG_FIRMWARE_LOADER_IMAGE_VIMAR_BLE)
  set(research_board_overlay "")
  if(DEFINED VIMAR_RESEARCH_BOARD_OVERLAY AND NOT VIMAR_RESEARCH_BOARD_OVERLAY STREQUAL "")
    if(NOT EXISTS "${VIMAR_RESEARCH_BOARD_OVERLAY}")
      message(FATAL_ERROR "VIMAR_RESEARCH_BOARD_OVERLAY does not exist")
    endif()
    set(research_board_overlay ";${VIMAR_RESEARCH_BOARD_OVERLAY}")
    set(firmware_DTC_OVERLAY_FILE "${APP_DIR}/boards/nrf52840dk_nrf52840_ota.overlay${research_board_overlay}" CACHE STRING "" FORCE)
  endif()
  set(mcuboot_CONF_FILE "${APP_DIR}/sysbuild/mcuboot_ota.conf" CACHE STRING "" FORCE)
  set(mcuboot_DTC_OVERLAY_FILE "${APP_DIR}/boards/ota-mcuboot.overlay${research_board_overlay}" CACHE STRING "" FORCE)
  set(vimar_recovery_DTC_OVERLAY_FILE "${APP_DIR}/boards/ota-loader.overlay${research_board_overlay}" CACHE STRING "" FORCE)
endif()
